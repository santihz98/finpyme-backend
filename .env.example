# PostgreSQL — use asyncpg driver
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finpyme

# JWT — generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-minimum-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Anthropic
ANTHROPIC_API_KEY=

# CORS (JSON list of allowed origins)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# App
APP_NAME=FinPyme API
DEBUG=false
